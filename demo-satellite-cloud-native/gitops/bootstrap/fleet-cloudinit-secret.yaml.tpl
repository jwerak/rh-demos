---
# Shared cloud-init for every fleet VM in one lifecycle environment.
# Rendered by gitops/scripts/bootstrap.sh (phase "secrets") from the env file
# and applied straight to the cluster. It is deliberately NOT stored in Git:
# it carries the demo password. Production: External Secrets / Sealed Secrets.
#
# Placeholders: __FLEET_ENV__ __DEMO_PASSWORD__ __IDM_FQDN__ __SAT_FQDN__
#               __IPA_DOMAIN__ __IPA_REALM__ __ENROLL_IDM__
#
# Registration source, in order:
#   1. /dev/disk/by-id/virtio-satreg -> file "<env>": registration command with
#      activation key AND host group, generated by the Satellite-as-code job
#      into Secret satellite-registration.
#   2. Fallback: http://<SAT_FQDN>/pub/register-lc-<env>.sh written by demo c1
#      (activation key only, no host group).
apiVersion: v1
kind: Secret
metadata:
  name: fleet-cloudinit-__FLEET_ENV__
  namespace: satellite-cloud-native
  labels:
    app.kubernetes.io/part-of: satellite-cloud-native
    app.kubernetes.io/component: fleet-cloudinit
    fleet.demo/environment: __FLEET_ENV__
    demo: satellite-cloud-native
type: Opaque
stringData:
  userData: |
    #cloud-config
    # users/chpasswd.users instead of the deprecated top-level user/password
    # keys, which make `cloud-init status` report "degraded".
    users:
      - default
    chpasswd:
      expire: false
      users:
        - name: cloud-user
          password: __DEMO_PASSWORD__
          type: text
    ssh_pwauth: true
    runcmd:
      - |
        set -euo pipefail
        exec > /var/log/client-setup.log 2>&1
        echo "=== Fleet Client Onboarding Starting (env: __FLEET_ENV__) ==="

        FLEET_ENV="__FLEET_ENV__"
        SAT_SVC="satellite.satellite-cloud-native.svc.cluster.local"
        IDM_SVC="idm.satellite-cloud-native.svc.cluster.local"
        IDM_FQDN="__IDM_FQDN__"
        SAT_FQDN="__SAT_FQDN__"
        IPA_DOMAIN="__IPA_DOMAIN__"
        IPA_REALM="__IPA_REALM__"
        ENROLL_IDM="__ENROLL_IDM__"

        # Hostname = VM name (KubeVirt DHCP host_name), domain = IPA domain
        VM_NAME=$(nmcli -t -f DHCP4.OPTION dev show eth0 2>/dev/null | grep ':host_name =' | sed 's/.*= //' | head -1)
        VM_NAME="${VM_NAME:-$(cloud-init query local_hostname 2>/dev/null || true)}"
        VM_NAME="${VM_NAME:-fleet-$(cat /proc/sys/kernel/random/boot_id | cut -c1-8)}"
        VM_NAME="${VM_NAME%%.*}"
        CLIENT_FQDN="${VM_NAME}.${IPA_DOMAIN}"
        hostnamectl set-hostname "${CLIENT_FQDN}"
        VM_IP=$(ip -4 addr show eth0 | grep -oP '(?<=inet )[\d.]+')
        sed -i 's/^127\.0\.0\.1.*/127.0.0.1 localhost localhost.localdomain/' /etc/hosts
        echo "${VM_IP} ${CLIENT_FQDN} ${VM_NAME}" >> /etc/hosts
        echo "Hostname: ${CLIENT_FQDN} IP: ${VM_IP}"

        IDM_IP=$(getent hosts "${IDM_SVC}" | awk '{print $1}' || true)
        SAT_IP=$(getent hosts "${SAT_SVC}" | awk '{print $1}' || true)
        [ -n "${IDM_IP}" ] && [ -n "${IDM_FQDN}" ] && echo "${IDM_IP} ${IDM_FQDN} idm" >> /etc/hosts
        [ -n "${SAT_IP}" ] && echo "${SAT_IP} ${SAT_FQDN} satellite" >> /etc/hosts

        # --- Phase 0: RHSM (CDN) registration for bootstrap packages ---
        echo "--- Registering to RHSM ---"
        mkdir -p /mnt/rhsm
        mount /dev/disk/by-id/virtio-rhsm-creds /mnt/rhsm || mount /dev/$(lsblk -n -o NAME,SERIAL | grep rhsm-creds | awk '{print $1}') /mnt/rhsm || true
        if [ -f /mnt/rhsm/org ] && [ -f /mnt/rhsm/activationkey ]; then
          subscription-manager register --org="$(cat /mnt/rhsm/org)" --activationkey="$(cat /mnt/rhsm/activationkey)"
        else
          echo "ERROR: RHSM credentials not found."
          exit 1
        fi
        subscription-manager repos --disable '*'
        subscription-manager repos \
          --enable=rhel-9-for-x86_64-baseos-rpms \
          --enable=rhel-9-for-x86_64-appstream-rpms \
          --enable=satellite-client-6-for-rhel-9-x86_64-rpms
        PKGS="foreman_ygg_worker"
        [ "${ENROLL_IDM}" = "true" ] && PKGS="${PKGS} ipa-client"
        dnf install -y ${PKGS}
        echo "--- RHSM Registration Complete ---"

        # --- Phase 1: IdM enrollment (optional) ---
        if [ "${ENROLL_IDM}" = "true" ]; then
          echo "--- Enrolling to IdM ---"
          for i in $(seq 1 30); do
            curl -sk "https://${IDM_FQDN}/" > /dev/null 2>&1 && break
            echo "Waiting for IdM... attempt ${i}/30"
            sleep 20
          done
          ipa-client-install \
            --server="${IDM_FQDN}" \
            --domain="${IPA_DOMAIN}" \
            --realm="${IPA_REALM}" \
            --principal=admin \
            --password='__DEMO_PASSWORD__' \
            --hostname="${CLIENT_FQDN}" \
            --no-ntp \
            --no-dns-sshfp \
            --unattended \
            --force-join \
            --force || echo "IdM enrollment failed (non-fatal)"
          if ! grep -q 'noaddresses' /etc/krb5.conf; then
            sed -i '/\[libdefaults\]/a\  noaddresses = true' /etc/krb5.conf
          fi
          echo "--- IdM Enrollment Complete ---"
        fi

        # --- Phase 2: Satellite registration (activation key + host group) ---
        echo "--- Registering to Satellite ---"
        REG_SCRIPT=""
        mkdir -p /mnt/satreg
        if mount /dev/disk/by-id/virtio-satreg /mnt/satreg 2>/dev/null \
           && [ -s "/mnt/satreg/${FLEET_ENV}" ]; then
          echo "Using GitOps registration command (host group) for ${FLEET_ENV}"
          REG_SCRIPT=$(cat "/mnt/satreg/${FLEET_ENV}")
        else
          REG_URL="http://${SAT_FQDN}/pub/register-lc-${FLEET_ENV}.sh"
          echo "No GitOps registration command, falling back to ${REG_URL}"
          for i in $(seq 1 60); do
            curl -sk "${REG_URL}" 2>/dev/null | grep -q 'curl' && break
            echo "Waiting for registration script... attempt ${i}/60"
            sleep 30
          done
          REG_SCRIPT=$(curl -sk "${REG_URL}" 2>/dev/null || true)
        fi
        if echo "${REG_SCRIPT}" | grep -q 'curl'; then
          eval "${REG_SCRIPT}" 2>&1 || echo "Satellite registration script had errors (non-fatal)"
        else
          echo "Registration command not available, skipping"
        fi

        # pull-mqtt REX (masquerade networking: Satellite cannot SSH in)
        getent group yggdrasil-worker > /dev/null 2>&1 || groupadd -r yggdrasil-worker
        usermod -a -G yggdrasil-worker root
        SAT_CERT_DIR="/etc/pki/consumer"
        if [ -f "${SAT_CERT_DIR}/cert.pem" ] && rpm -q yggdrasil > /dev/null 2>&1; then
          cat > /etc/yggdrasil/config.toml <<YGGEOF
        broker = ["mqtts://${SAT_FQDN}:1883"]
        server = ["mqtts://${SAT_FQDN}:1883"]
        cert-file = "${SAT_CERT_DIR}/cert.pem"
        key-file = "${SAT_CERT_DIR}/key.pem"
        ca-root = ["/etc/rhsm/ca/katello-server-ca.pem"]
        log-level = "error"
        path-prefix = "yggdrasil"
        YGGEOF
          systemctl enable --now yggdrasild com.redhat.Yggdrasil1.Worker1.foreman.service 2>/dev/null || true
        fi
        echo "--- Satellite Registration Complete ---"
        echo "=== Fleet Client Onboarding Finished ==="
