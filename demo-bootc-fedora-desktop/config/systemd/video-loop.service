[Unit]
Description=Fullscreen video loop
After=graphical-session.target
PartOf=graphical-session.target
StartLimitIntervalSec=0

[Service]
Environment=WAYLAND_DISPLAY=wayland-0
ExecStart=/usr/bin/mpv --vo=wlshm --hwdec=no --fullscreen --ontop --loop-playlist=inf --no-terminal /usr/local/share/videos
Restart=always
RestartSec=1

[Install]
WantedBy=graphical-session.target
