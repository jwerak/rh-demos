# Execution environment for the GitOps layer: AAP job templates, the Argo CD
# fallback Job (gitops/repo/satellite/job.yaml) and run-local.sh all use it.
#
# Base: AAP's supported EE, which already ships redhat.satellite,
# kubernetes.core, redhat.openshift_virtualization and python kubernetes.
# Pulled with the cluster pull secret (no Automation Hub token needed).
# Added here: rpm-build, so SAT · Publish new version can build demo-app.
#
# Built in the cluster by `gitops/scripts/bootstrap.sh runner` (oc new-build,
# Docker strategy) into ImageStream satellite-cloud-native/satellite-cac-runner.
# Laptop (run-local.sh): podman build needs `podman login registry.redhat.io`.
ARG EE_BASE=registry.redhat.io/ansible-automation-platform-27/ee-supported-rhel9:latest
FROM ${EE_BASE}

USER 0
RUN (microdnf -y install rpm-build || dnf -y install rpm-build) \
 && (microdnf clean all || dnf clean all) \
 && rpmbuild --version

# OpenShift runs the container with a random UID in group 0. The project
# directory can be a read-only mount, so pin Ansible's temp paths to /tmp.
USER 1000
ENV ANSIBLE_HOST_KEY_CHECKING=False \
    ANSIBLE_RETRY_FILES_ENABLED=False \
    ANSIBLE_LOCAL_TEMP=/tmp/.ansible/tmp \
    ANSIBLE_REMOTE_TMP=/tmp/.ansible/tmp
