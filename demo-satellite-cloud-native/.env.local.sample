# Local workstation profile: Satellite + Capsule + CentOS Stream 9 client,
# all as libvirt VMs on this machine.
#
#   cp .env.local.sample .env.local
#   $EDITOR .env.local
#   ./scripts/deploy-local.sh
#
# Differences from .env (the remote KVM host profile):
#   - LIBVIRT_HOST is localhost, reached over loopback SSH
#   - IdM is not deployed
#   - a Capsule is deployed and serves content to a CentOS client
#   - the Satellite is sized to fit a laptop rather than a server
#   - no subscription manifest and no Caddy reverse proxy are needed

# --- Red Hat subscription (required) -------------------------------------
# https://console.redhat.com/settings/connector/activation-keys
# The key must entitle both satellite-6.19-* and satellite-capsule-6.19-*.
export RHSM_ORG=
export RHSM_ACTIVATION_KEY=

# --- Lab DNS -------------------------------------------------------------
# Resolved by the libvirt network's own dnsmasq, which is authoritative for
# LAB_DOMAIN, plus /etc/hosts entries written on the host and in each VM.
# No public DNS records are needed. The first label of each FQDN must match
# the DHCP reservation name in ansible/libvirt-host-setup.yml.
export LAB_DOMAIN=demo.lab
export SAT_FQDN=satellite.demo.lab
export CAPSULE_FQDN=capsule.demo.lab

# --- Profile switches ----------------------------------------------------
export DEMO_PLATFORM=libvirt
export DEMO_LOCAL_PROFILE=true
export DEPLOY_IDM=false
export DEPLOY_CAPSULE=true

# --- Local libvirt -------------------------------------------------------
# localhost, not a remote host: the deploy still goes over SSH, it just
# loops back. Requires sshd running, your key in ~/.ssh/authorized_keys,
# and passwordless sudo.
export LIBVIRT_HOST=localhost
export LIBVIRT_USER=jveverka
export LIBVIRT_SSH_KEY=~/.ssh/id_ed25519
export LIBVIRT_NETWORK=satellite-demo
export LIBVIRT_POOL_DIR=/var/lib/libvirt/images

# Base images. The RHEL image must be downloaded manually from
# access.redhat.com; the CentOS Stream image is fetched by host setup.
export LIBVIRT_RHEL9_IMAGE=rhel-9.8-x86_64-kvm.qcow2
export LIBVIRT_RHEL9_IMAGE_SOURCE=/home/jveverka/Software/OS/RHEL
export LIBVIRT_CENTOS9_IMAGE=centos-stream-9-x86_64-kvm.qcow2

# --- Sizing --------------------------------------------------------------
# Satellite runs on 12 GB here (see the satellite-local profile in
# ansible/vars/vm-profiles.yml), which is below the installer's RAM
# pre-check, hence the two flags below. 12 + 6 + 2 GB of guests on a 30 GB
# machine is tight: close heavy applications during the install.
export SAT_TUNING=development
export SAT_DISABLE_SYSTEM_CHECKS=true
export CAPSULE_TUNING=development

# --- Demo password -------------------------------------------------------
# Generated and appended here on first run if left unset.
# export DEMO_PASSWORD=

# --- Not used by this profile --------------------------------------------
# IDM_FQDN       - no IdM (DEPLOY_IDM=false)
# MANIFEST_PATH  - the Capsule demo uses custom and upstream repos only
