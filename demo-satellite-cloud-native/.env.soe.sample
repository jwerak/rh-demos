# SOE profile: Satellite + lc-dev + lc-qa + lc-prod + a CentOS Stream 9
# client, all as libvirt VMs on this workstation. No Capsule, no IdM.
#
#   cp .env.soe.sample .env.soe
#   $EDITOR .env.soe
#   ./scripts/deploy-soe.sh
#
# This is a variant of the local workstation profile (.env.local), not a
# replacement. The OpenShift, remote-KVM and Capsule-local profiles are
# untouched and keep working exactly as before.
#
# Differences from .env.local:
#   - DEPLOY_CAPSULE=false   (saves 6 GB; the Capsule is not this story)
#   - DEPLOY_CENTOS=true     (stages the CentOS Stream image without a Capsule)
#   - the three lifecycle clients are pre-staged by deploy-soe.sh
#   - guests are trimmed to 1536 MB so 5 VMs fit the same 20 GB envelope

# --- Red Hat subscription (required) -------------------------------------
# https://console.redhat.com/settings/connector/activation-keys
# The key must entitle satellite-6.19-for-rhel-9-x86_64-rpms and
# satellite-maintenance-6.19-for-rhel-9-x86_64-rpms. Unlike .env.local it
# does NOT need satellite-capsule-6.19-*: no Capsule is built here.
export RHSM_ORG=
export RHSM_ACTIVATION_KEY=

# --- Lab DNS -------------------------------------------------------------
# Resolved by the libvirt network's own dnsmasq, which is authoritative for
# LAB_DOMAIN, plus /etc/hosts entries written on the host and in each VM.
# No public DNS records are needed.
export LAB_DOMAIN=demo.lab
export SAT_FQDN=satellite.demo.lab

# --- Profile switches ----------------------------------------------------
export DEMO_PLATFORM=libvirt
export DEMO_LOCAL_PROFILE=true
export DEMO_SOE_PROFILE=true
export DEPLOY_IDM=false
export DEPLOY_CAPSULE=false
export DEPLOY_CENTOS=true

# Trimmed guest profiles from ansible/vars/vm-profiles.yml. These are what
# keep five concurrent guests inside the RAM envelope.
export LC_VM_PROFILE=lc-client-soe
export CENTOS_VM_PROFILE=centos-client-soe

# --- Local libvirt -------------------------------------------------------
# localhost, not a remote host: the deploy still goes over SSH, it just
# loops back. Requires sshd running, your key in ~/.ssh/authorized_keys,
# and passwordless sudo.
export LIBVIRT_HOST=localhost
export LIBVIRT_USER=jveverka
export LIBVIRT_SSH_KEY=~/.ssh/id_ed25519
export LIBVIRT_NETWORK=satellite-demo
export LIBVIRT_POOL_DIR=/var/lib/libvirt/images

# Base images. The RHEL image must be downloaded manually from
# access.redhat.com; the CentOS Stream image is fetched by host setup.
export LIBVIRT_RHEL9_IMAGE=rhel-9.8-x86_64-kvm.qcow2
export LIBVIRT_RHEL9_IMAGE_SOURCE=/home/jveverka/Software/OS/RHEL
export LIBVIRT_CENTOS9_IMAGE=centos-stream-9-x86_64-kvm.qcow2

# --- Sizing --------------------------------------------------------------
# Satellite runs on 12 GB here (the satellite-local profile), which is below
# the installer's RAM pre-check, hence the two flags below.
#   satellite 12288 + 4 guests * 1536 = 18 GB of concurrent guest RAM.
export SAT_TUNING=development
export SAT_DISABLE_SYSTEM_CHECKS=true

# --- Demo password -------------------------------------------------------
# Generated and appended here on first run if left unset.
# export DEMO_PASSWORD=

# --- Not used by this profile --------------------------------------------
# IDM_FQDN       - no IdM (DEPLOY_IDM=false)
# CAPSULE_FQDN   - no Capsule (DEPLOY_CAPSULE=false)
# MANIFEST_PATH  - optional. Without it the Satellite has no Red Hat repos
#                  and the lifecycle demo runs on the custom Demo-App
#                  product only. See RUNSHEET-soe.md, "What is not shown".
