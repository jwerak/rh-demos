# Filled from the "Infrastructure | Automation Orchestrator | Install" job output,
# or from `aap-demo status` after `aap-demo enable ao`.
export AO_URL=https://automation-orchestrator-automation-orchestrator.apps.example.com
export AO_USERNAME=admin
export AO_PASSWORD=change-me

# AAP on the same lab or local cluster, when a scenario needs controller access.
export CONTROLLER_HOST=https://aap-aap.apps.example.com
export CONTROLLER_USERNAME=admin
export CONTROLLER_PASSWORD=change-me

# Persistent AAP gateway token for the AO "AAP MCP" integration bearer field.
# configure-ao.yml creates one when this is empty. Paste it back here so
# re-runs reuse it instead of leaving spare tokens on the gateway.
export AAP_MCP_TOKEN=

export RHSM_ORG_ID=<RHSM_ORG_ID>
export RHSM_ACTIVATION_KEY=<RHSM_ACTIVATION_KEY>

# Optional. Default is ao-cve-<cluster id> taken from CONTROLLER_HOST.
# export AO_INSIGHTS_GROUP=<unique-group-name>

# Service account on User Access group cve-remediator (console name "cve lab mcp").
# Reset the client secret in the console if you no longer have it. The existing secret cannot be viewed again.
export LIGHTSPEED_CLIENT_ID=<LIGHTSPEED_CLIENT_ID>
export LIGHTSPEED_CLIENT_SECRET=<LIGHTSPEED_CLIENT_SECRET>

export AO_MODEL_BASE_URL=<AO_MODEL_BASE_URL>
export AO_MODEL_NAME=<AO_MODEL_NAME>
export AO_MODEL_ACCESS_TOKEN=<AO_MODEL_ACCESS_TOKEN>

# Gitea on this cluster. deploy_gitea_ocp.yml creates the admin, lab-user, and PAT.
export GITEA_URL=https://gitea-gitea.apps.example.com
export GITEA_REPO=lab-user/lightspeed_playbooks
export GITEA_TOKEN=<GITEA_TOKEN>
export GITEA_ADMIN_PASSWORD=<GITEA_ADMIN_PASSWORD>
export GITEA_LAB_USER_PASSWORD=<GITEA_LAB_USER_PASSWORD>