# Log files
*.log
ansible-navigator.log

# Environment files
# Real env files hold RHSM activation keys and demo passwords. The *.sample
# files are the tracked templates and must stay visible.
.env
.env.local
.env.soe
**/.env
**/.env.local
**/.env.soe
!**/.env.example
!**/.env.sample
!**/.env.local.sample
!**/.env.soe.sample


# Vault files (if they contain real secrets)
# Uncomment if vault.yml contains real secrets:
# vault.yml

# Temporary files
*.tmp
*.swp
*~

# OS files
.DS_Store
Thumbs.db

# Ansible EE build artifacts
**/context/_build/
